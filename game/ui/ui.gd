static func scroll(child: Control, horizontal: bool = false) -> ScrollContainer:
	var sc := DragScroll.new()
	sc.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO if horizontal else ScrollContainer.SCROLL_MODE_DISABLED
	sc.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED if horizontal else ScrollContainer.SCROLL_MODE_AUTO
	sc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.size_flags_vertical = Control.SIZE_EXPAND_FILL
	child.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.add_child(child)
	return sc

static func bar(value: float, max_value: float, variant: String = "", h: float = 12.0, show_pct: bool = false) -> ProgressBar:
	var p := ProgressBar.new()
	p.max_value = maxf(1.0, max_value)
	p.value = value
	p.show_percentage = show_pct
	p.custom_minimum_size = Vector2(0, h)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if variant != "":
		p.theme_type_variation = variant
	if not Game.reduce_fx() and variant in ["", "GoldBar"] and h >= 8.0:
		_bar_gloss(p, h)
		# bars built while a screen is opening fill up from empty
		if Time.get_ticks_msec() - int(Game.get_meta("screen_t", -99999)) < 450 and value > 0.0:
			var target := value
			p.value = 0.0
			p.ready.connect(func():
				p.create_tween().tween_property(p, "value", target, 0.7).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT).set_delay(0.18), CONNECT_ONE_SHOT)
	return p

## Glossy top highlight + slow light sweep, clipped to the filled part of a bar.
static func _bar_gloss(p: ProgressBar, h: float) -> void:
	var clip := Control.new()
	clip.clip_contents = true
	clip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	p.add_child(clip)
	var hi := ColorRect.new()
	hi.color = Color(1, 1, 1, 0.2)
	hi.mouse_filter = Control.MOUSE_FILTER_IGNORE
	clip.add_child(hi)
	var sh := Control.new()
	sh.mouse_filter = Control.MOUSE_FILTER_IGNORE
	clip.add_child(sh)
	var sweep := shine(sh, 4.5, 0.55, Color(1, 1, 0.95), minf(6.0, h * 0.5))
	if sweep != null:
		sweep.material.set_shader_parameter("inset", 0.0)
		sweep.material.set_shader_parameter("width", 0.08)
	var fit := func():
		var span := p.max_value - p.min_value
		var r := 0.0 if span <= 0.0 else clampf((p.value - p.min_value) / span, 0.0, 1.0)
		var w := floorf(p.size.x * r)
		clip.position = Vector2(1, 1)
		clip.size = Vector2(maxf(0.0, w - 2.0), maxf(0.0, p.size.y - 2.0))
		clip.visible = w > 4.0
		hi.position = Vector2(2, 1)
		hi.size = Vector2(maxf(0.0, clip.size.x - 4.0), maxf(1.0, round(clip.size.y * 0.32)))
		sh.size = Vector2(maxf(p.size.x - 2.0, 1.0), clip.size.y)
	p.resized.connect(fit)
	p.value_changed.connect(func(_v: float): fit.call())
	p.changed.connect(fit)

static func stars(n: int, size: int = 16, max_n: int = 0) -> Label:
	var t := "★".repeat(n)
	if max_n > n:
		t += "☆".repeat(max_n - n)
	var l := label(t, size, GOLD, 3)
	return l

const BlackFlame = preload("res://game/ui/black_flame.gd")

## Where the head of `art` (a TextureRect showing a full-body art, keep-aspect) is on screen: centre + radius
## in global px, from the pivot rig head (or the face crop when there is no rig).
static func head_on_screen(art: TextureRect) -> Array:
	var t := art.texture
	if t == null or art.size.x <= 0.0:
		return [art.get_global_rect().get_center(), 40.0]
	var ts := t.get_size()
	var s := minf(art.size.x / ts.x, art.size.y / ts.y)
	var draw := ts * s
	var off := (art.size - draw) * 0.5
	var r := DB.char_rig(t)
	var hv: Variant = r.get("head", null)
	var uv := Vector2(0.5, 0.15)
	var rad := 0.05
	if hv is Vector3:
		uv = Vector2(hv.x, hv.y)
		rad = hv.z
	elif hv is Array and (hv as Array).size() >= 3:
		uv = Vector2(float(hv[0]), float(hv[1]))
		rad = float(hv[2])
	else:
		var ff := DB.face_focus(t)
		uv = Vector2(ff.x, ff.y)
	var xf := art.get_global_transform()
	var p := xf * (off + uv * draw)
	return [p, rad * draw.y * xf.get_scale().y]

## A hero's reaction as small floating text next to her head: no box (outline only), on the side of the head
## with more free room inside `bounds` (global rect; empty = the host), so it never covers her face.
## Replaces the previous one on the same host; fades out after a few seconds.
static func float_speech(host: Control, art: TextureRect, who: String, text: String, bounds: Rect2 = Rect2()) -> void:
	var old := host.get_node_or_null("FloatSpeech")
	if old:
		old.name = "FloatSpeechOld"
		old.queue_free()
	if bounds.size == Vector2.ZERO:
		bounds = host.get_global_rect()
	var hd := head_on_screen(art)
	var hp: Vector2 = hd[0]
	var hr: float = maxf(24.0, float(hd[1]))
	var w := 230.0
	var room_l := hp.x - hr * 1.3 - bounds.position.x
	var room_r := bounds.end.x - (hp.x + hr * 1.3)
	var right := room_r >= room_l
	var x := hp.x + hr * 1.3 if right else hp.x - hr * 1.3 - w
	x = clampf(x, bounds.position.x + 4.0, bounds.end.x - w - 4.0)
	var box := VBoxContainer.new()
	box.name = "FloatSpeech"
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_theme_constant_override("separation", 0)
	box.custom_minimum_size = Vector2(w, 0)
	var nm := label(DB.name_of(who).split(" ")[0], 12, DB.theme_color(who).lightened(0.45), 4)
	nm.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
	var tl := label(text, 13, Color.WHITE, 5)
	tl.add_theme_color_override("font_outline_color", Color(0.05, 0.02, 0.08, 0.95))
	tl.add_theme_constant_override("shadow_offset_x", 1)
	tl.add_theme_constant_override("shadow_offset_y", 2)
	tl.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.6))
	tl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	tl.custom_minimum_size = Vector2(w, 0)
	for l in [nm, tl]:
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT if right else HORIZONTAL_ALIGNMENT_RIGHT
		box.add_child(l)
	host.add_child(box)
	var inv := host.get_global_transform().affine_inverse()
	var y := clampf(hp.y - hr * 0.6, bounds.position.y + 4.0, bounds.end.y - 80.0)
	box.position = inv * Vector2(x, y)
	if OS.get_environment("SPEECH_DEBUG") != "":
		print("SPEECH host=%s text='%s' head=%s bounds=%s pos=%s" % [host.name, text, str(hp), str(bounds), str(box.position)])
	box.modulate.a = 0.0
	var tw := box.create_tween()
	tw.tween_property(box, "modulate:a", 1.0, 0.18)
	tw.parallel().tween_property(box, "position:y", box.position.y - 8.0, 0.4).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tw.tween_interval(clampf(1.6 + text.length() * 0.045, 2.4, 5.0))
	tw.tween_property(box, "modulate:a", 0.0, 0.35)
	tw.tween_callback(box.queue_free)

## A hero's rank as stars: 1-6 gold stars, then 6 stars in the Evolution tier colour (Azure blue, Crimson red,
## Violet purple) and Abyss = black stars with a black-flame aura. `compact` drops the empty ☆ slots.
static func rank_stars(star: int, evo: int, evo_star: int, size: int = 16, compact: bool = false) -> Control:
	var box := Control.new()
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var text := ""
	var col := GOLD
	var outline := 3
	var outline_col := Color(0, 0, 0, 0.85)
	if evo <= 0:
		text = "★".repeat(star) + ("" if compact else "☆".repeat(maxi(0, DB.MAX_STAR - star)))
	else:
		col = DB.evo_color(evo)
		text = "★".repeat(evo_star) + ("" if compact else "☆".repeat(maxi(0, DB.EVO_STARS - evo_star)))
		if evo >= DB.MAX_EVO:
			outline = 5
			outline_col = Color("#b04bff")
		else:
			outline_col = col.darkened(0.65)
	var l := label(text, size, col, outline)
	l.add_theme_color_override("font_outline_color", outline_col)
	l.name = "stars"
	box.add_child(l)
	if evo >= DB.MAX_EVO:
		var fl: Control = BlackFlame.new()
		fl.stars = maxi(1, text.length())
		fl.show_behind_parent = true
		fl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		fl.offset_top = -size * 1.15
		fl.offset_bottom = -size * 0.2
		l.add_child(fl)
	# the box takes the label's size (Control parents do not size themselves)
	box.custom_minimum_size = l.get_combined_minimum_size()
	l.resized.connect(func(): box.custom_minimum_size = l.size)
	return box

## rank_stars for an owned hero id.
static func hero_rank_stars(id: String, size: int = 16, compact: bool = false) -> Control:
	var h := Game.hero(id)
	var st: int = int(h.get("star", DB.RARITY_START_STAR[DB.rarity_of(id)]))
	return rank_stars(st, int(h.get("evo", 0)), int(h.get("evo_star", 0)), size, compact)

## "Azure 3★" / "4★" text of a hero's rank.
static func rank_text(id: String) -> String:
	var h := Game.hero(id)
	var e := int(h.get("evo", 0))
	return "%s %d★" % [DB.evo_name(e), int(h.get("evo_star", 0))] if e > 0 else "%d★" % int(h.get("star", 1))

const RARITY_FRAME_MODE := {"LR": 1, "GR": 2, "OR": 3, "MR": 4}
const RARITY_AURA := {"N": 0.0, "R": 0.15, "SR": 0.3, "SSR": 0.45, "UR": 0.55, "LR": 0.7, "MR": 0.75, "GR": 0.85, "OR": 0.9}
static var _rarity_shader: Shader

## Rarity border + aura around `card` (game/ui/rarity_frame.gdshader): solid for N..UR, animated rainbow (LR),
## magenta-red (MR), white hologram (GR) and cosmic black (OR). Added as the card's child, `pad` px outside it.
static func rarity_frame(card: Control, rarity: String, radius: float = 10.0, width: float = 2.0, pad: float = 9.0, aura_scale: float = 1.0) -> ColorRect:
	if _rarity_shader == null:
		_rarity_shader = load("res://game/ui/rarity_frame.gdshader")
	var r := ColorRect.new()
	r.name = "rarity_frame"
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.set_anchors_preset(Control.PRESET_FULL_RECT)
	r.offset_left = -pad
	r.offset_top = -pad
	r.offset_right = pad
	r.offset_bottom = pad
	var m := ShaderMaterial.new()
	m.shader = _rarity_shader
	m.set_shader_parameter("pad", pad)
	m.set_shader_parameter("radius", radius)
	m.set_shader_parameter("width", width)
	m.set_shader_parameter("base_color", DB.RARITY_COLOR.get(rarity, ACCENT))
	m.set_shader_parameter("mode", int(RARITY_FRAME_MODE.get(rarity, 0)))
	m.set_shader_parameter("aura", float(RARITY_AURA.get(rarity, 0.2)) * aura_scale)
	m.set_shader_parameter("speed", 0.0 if Game.reduce_fx() else 1.0)
	r.material = m
	var sync := func(): m.set_shader_parameter("rect_size", r.size)
	r.resized.connect(sync)
	card.add_child(r)
	sync.call()
	return r

## Picture badge (rarity logo or role word) `h` px tall, aspect kept, smooth when scaled down.
static func badge_rect(t: Texture2D, h: float) -> TextureRect:
	var r := TextureRect.new()
	r.texture = t
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var w := h * (float(t.get_width()) / float(t.get_height())) if t != null else h
	r.custom_minimum_size = Vector2(w, h)
	r.size = Vector2(w, h)
	return r

static var _rarity_text_shader: Shader

## Rarity name ("LEGEND") in the rarity's border colours: solid N..UR, animated rainbow LR, magenta-red MR,
## white hologram GR, cosmic black OR (game/ui/rarity_text.gdshader).
static func rarity_text(rarity: String, size: int = 16, long_name: bool = true) -> Label:
	# the words on the badge art (SSR stays SSR)
	var shown := {"N": "NORMAL", "R": "RARE", "SR": "SUPER RARE", "SSR": "SSR", "UR": "ULTRA RARE", "LR": "LEGEND", "MR": "MYTHIC", "GR": "GOD", "OR": "VOID"}
	var txt: String = str(shown.get(rarity, rarity)) if long_name else rarity
	var c: Color = DB.RARITY_COLOR.get(rarity, ACCENT)
	var mode := int(RARITY_FRAME_MODE.get(rarity, 0))
	var l := label(txt, size, Color.WHITE if mode != 0 else c.lightened(0.15), 4)
	# Void is a dark fill, so it gets a violet rim instead of the black one (kept dim enough that
	# rarity_text.gdshader still treats it as the outline pass)
	l.add_theme_color_override("font_outline_color", Color(0.04, 0.02, 0.08) if rarity != "OR" else Color(0.5, 0.32, 0.62))
	if mode != 0:
		if _rarity_text_shader == null:
			_rarity_text_shader = load("res://game/ui/rarity_text.gdshader")
		var m := ShaderMaterial.new()
		m.shader = _rarity_text_shader
		m.set_shader_parameter("mode", mode)
		m.set_shader_parameter("speed", 0.0 if Game.reduce_fx() else 1.0)
		m.set_shader_parameter("width", float(txt.length() * size) * 0.7)
		l.material = m
	return l

## Rarity logo badge (art/ui/rarity/) about 1.6 x `size` tall; a text chip if the art is missing.
static func rarity_tag(rarity: String, size: int = 14) -> PanelContainer:
	var bt := DB.rarity_badge(rarity)
	if bt != null:
		var bp := PanelContainer.new()
		bp.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
		bp.mouse_filter = Control.MOUSE_FILTER_IGNORE
		bp.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		bp.tooltip_text = str(DB.RARITY_NAME.get(rarity, rarity))
		bp.add_child(badge_rect(bt, size * 1.6))
		return bp
	var c: Color = DB.RARITY_COLOR.get(rarity, ACCENT)
	var p := styled_panel(c.darkened(0.55), c, 6, 2, 6)
	var l := label(rarity, size, c.lightened(0.2), 2)
	p.add_child(l)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return p

