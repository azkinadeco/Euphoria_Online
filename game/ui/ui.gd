static var _live_shader: Shader

## Attach the pseudo-Live2D motion shader to a hero art TextureRect.
static func live(t: TextureRect, rim_col: Color = Color(1, 0.85, 1), strength: float = 1.0) -> void:
	if _live_shader == null:
		_live_shader = load("res://game/ui/live_art.gdshader")
	var m := ShaderMaterial.new()
	m.shader = _live_shader
	m.set_shader_parameter("strength", strength * (0.35 if Game.reduce_fx() else 1.0))
	m.set_shader_parameter("seed", randf() * 10.0)
	m.set_shader_parameter("rim_color", rim_col)
	if t.has_meta("corrupt_params"):
		t.remove_meta("corrupt_params")
	t.material = m
	# 2.5D rigged arts (DB.LIVE_RIGS) take over automatically while they are shown
	if not t.has_node("LiveRig"):
		var rig := LiveRig.new()
		rig.name = "LiveRig"
		t.add_child(rig)
	else:
		(t.get_node("LiveRig") as LiveRig).set_live(m)
	# pivot-rigged arts (DB.HERO_RIGS / ENEMY_RIGS): breathing, blinking, hair & tail sway
	var cr := CharRig.attach(t)
	if cr.is_inside_tree():
		cr.refresh()

static var _corrupt_shader: Shader

## Elite / corrupted enemy look (placeholder for unique enemy art).
static func corrupt(t: CanvasItem, variant: String = "") -> void:
	if _corrupt_shader == null:
		_corrupt_shader = load("res://game/ui/corrupt.gdshader")
	var m := ShaderMaterial.new()
	m.shader = _corrupt_shader
	if variant == "ashen":
		# Ashen (Arc 7): grey cinders with a glowing ember outline
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.85)
		m.set_shader_parameter("glow", Color("#ff9a3d"))
	elif variant == "echo":
		# Echo (Arc 6): faded sepia memory with a pale gold outline
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.75)
		m.set_shader_parameter("glow", Color("#f0dca0"))
	elif variant == "astral":
		# Astral (Arc 5 / Boss Hunt): starlit gold halo, colours kept closer to the original
		m.set_shader_parameter("hue_shift", 0.06)
		m.set_shader_parameter("glow", Color("#ffe27a"))
	elif variant == "feral":
		# Feral (Arc 9): drained, wild look with a blood-red hunting halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.5)
		m.set_shader_parameter("glow", Color("#ff3b2e"))
	elif variant == "frost":
		# Frostbound (Arc 11): pale glacier-blue skin of ice with a white-blue rime halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.8)
		m.set_shader_parameter("tone", Vector3(0.74, 1.08, 1.62))
		m.set_shader_parameter("glow", Color("#bff0ff"))
	elif variant == "jade":
		# Masked (Arc 13): carved-jade green, as if the whole figure were cut from the mask's stone, with a pale green halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.6)
		m.set_shader_parameter("tone", Vector3(0.78, 1.36, 0.98))
		m.set_shader_parameter("glow", Color("#8dffc0"))
	elif variant == "dream":
		# Dreambound (Arc 12): soft rose-violet haze, like a painting seen through closed eyelids, with a pink halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.55)
		m.set_shader_parameter("tone", Vector3(1.42, 0.98, 1.36))
		m.set_shader_parameter("glow", Color("#ffb3ec"))
	elif variant == "hollow":
		# Hollow (Arc 4): drained, icy-teal look with a cyan halo
		m.set_shader_parameter("hue_shift", 0.45)
		m.set_shader_parameter("glow", Color("#4ff0ff"))
	t.material = m
	# 2.5D: a rigged / depth-mapped art keeps its depth and gets the variant look on top
	if t is TextureRect:
		t.set_meta("corrupt_params", {"hue_shift": m.get_shader_parameter("hue_shift"), "desat": m.get_shader_parameter("desat"), "variant_glow": m.get_shader_parameter("glow"), "tone": m.get_shader_parameter("tone")})
		if not t.has_node("LiveRig"):
			var rig := LiveRig.new()
			rig.name = "LiveRig"
			t.add_child(rig)
		else:
			(t.get_node("LiveRig") as LiveRig).set_live(m)

## Tap-to-animate banner: plays frames 1→2→3… once like a GIF and holds on the last one.
static func play_frames(t: TextureRect, frames: Array, step: float = 0.32) -> void:
	if t.has_meta("frames_tw"):
		var old: Tween = t.get_meta("frames_tw")
		if old and old.is_valid():
			old.kill()
	var tw := t.create_tween()
	for i in frames.size():
		var p: String = frames[i]
		tw.tween_callback(func():
			t.texture = DB.tex(p)
			t.pivot_offset = t.size * 0.5
			t.scale = Vector2(1.04, 1.04))
		tw.tween_property(t, "scale", Vector2.ONE, step * 0.6).set_trans(Tween.TRANS_BACK)
		tw.tween_interval(step * 0.4)
	t.set_meta("frames_tw", tw)

## Show an alternate expression for a moment, then restore (used on touch).
static func flash_expression(t: TextureRect, alt: Texture2D, hold: float = 1.6) -> void:
	if alt == null or t.has_meta("expr_busy"):
		return
	var orig := t.texture
	t.set_meta("expr_busy", true)
	t.texture = alt
	var tw := t.create_tween()
	tw.tween_interval(hold)
	tw.tween_callback(func():
		if is_instance_valid(t):
			t.texture = orig
			t.remove_meta("expr_busy"))

static func fade_in(node: CanvasItem, dur: float = 0.25, from_offset: Vector2 = Vector2(0, 16)) -> void:
	node.modulate.a = 0.0
	var tw := node.create_tween().set_parallel(true).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_property(node, "modulate:a", 1.0, dur)
	if node is Control and from_offset != Vector2.ZERO:
		var c := node as Control
		if c.get_parent() is Container:
			# A container places its children on the NEXT layout pass, so the position read here is often a
			# stale (0, 0). Tweening to it pinned the content against the panel frame (no padding left/top).
			# Slide relative to wherever the container puts the node, and let it re-sort at the end.
			var par := c.get_parent() as Container
			var st := {"base": c.position, "p": 0.0}
			var on_sort := func():
				if is_instance_valid(c):
					st["base"] = c.position
					c.position = (st["base"] as Vector2) + from_offset * (1.0 - float(st["p"]))
			par.sort_children.connect(on_sort)
			c.position = (st["base"] as Vector2) + from_offset
			tw.tween_method(func(pr: float):
				st["p"] = pr
				c.position = (st["base"] as Vector2) + from_offset * (1.0 - pr), 0.0, 1.0, dur)
			tw.chain().tween_callback(func():
				if is_instance_valid(par):
					if par.sort_children.is_connected(on_sort):
						par.sort_children.disconnect(on_sort)
					par.queue_sort())
			return
		var target := c.position
		c.position = target + from_offset
		tw.tween_property(c, "position", target, dur)

static func pop(node: Control, dur: float = 0.3) -> void:
	node.pivot_offset = node.size * 0.5
	# containers lay out a frame later: keep the pivot centred while it grows
	var piv := func(): node.pivot_offset = node.size * 0.5
	if not node.resized.is_connected(piv):
		node.resized.connect(piv)
	node.scale = Vector2(0.6, 0.6)
	node.modulate.a = 0.0
	# the tween starts one frame later: content is usually built right after pop() in the same (long) frame,
	# and a tween started there would spend most of its time in that single first step
	var start := func():
		if is_instance_valid(node) and node.is_inside_tree():
			await node.get_tree().process_frame
			if is_instance_valid(node):
				var tw := node.create_tween().set_parallel(true).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
				tw.tween_property(node, "scale", Vector2.ONE, dur)
				tw.tween_property(node, "modulate:a", 1.0, dur * 0.6)
	start.call_deferred()

static func breathe(node: Control, amount: float = 0.012, period: float = 3.2) -> void:
	node.pivot_offset = Vector2(node.size.x * 0.5, node.size.y)
	var tw := node.create_tween().set_loops()
	tw.tween_property(node, "scale", Vector2(1.0 + amount * 0.4, 1.0 + amount), period * 0.5).set_trans(Tween.TRANS_SINE)
	tw.tween_property(node, "scale", Vector2.ONE, period * 0.5).set_trans(Tween.TRANS_SINE)

## Top-3 podium card for leaderboards (k = 0 gold, 1 silver, 2 bronze). e: {name, hero, me}.
## Round "view full screen" button (magnifier icon) that opens ArtViewer.
static func zoom_button(on_press: Callable) -> Button:
	var b := Button.new()
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(58, 58)
	b.icon = DB.icon("icon_zoom")
	b.expand_icon = true
	b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	b.tooltip_text = "View full screen (pinch to zoom, tap to interact)"
	b.add_theme_constant_override("icon_max_width", 34)
	b.add_theme_stylebox_override("normal", style(Color(0.08, 0.04, 0.16, 0.86), Color(GOLD, 0.8), 29, 2, 10))
	b.add_theme_stylebox_override("hover", style(Color(0.2, 0.1, 0.32, 0.95), GOLD, 29, 3, 10))
	b.add_theme_stylebox_override("pressed", style(Color(0.3, 0.16, 0.42, 0.95), GOLD, 29, 3, 10))
	b.pressed.connect(func():
		Game.sfx("ui_click")
		on_press.call())
	var tw := b.create_tween().set_loops()
	tw.tween_property(b, "self_modulate", Color(1.25, 1.15, 0.9), 1.1).set_trans(Tween.TRANS_SINE)
	tw.tween_property(b, "self_modulate", Color.WHITE, 1.1).set_trans(Tween.TRANS_SINE)
	return b

static func podium(e: Dictionary, k: int, value: String) -> Control:
	var cols := [GOLD, Color("#d8d8e8"), Color("#e0a070")]
	var col: Color = cols[k]
	var me: bool = e.get("me", false)
	var p := styled_panel(Color(col, 0.12) if not me else Color(0.25, 0.18, 0.05, 0.95), col, 12, 2 if (k == 0 or me) else 1, 6.0)
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	p.size_flags_vertical = Control.SIZE_SHRINK_END
	var v := vbox(3)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	p.add_child(v)
	if k == 0:
		var cr := label("♛", 20, col, 3)
		cr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		v.add_child(cr)
	var face := tex_rect(DB.face(e["hero"]), Vector2(56, 56) if k == 0 else Vector2(46, 46), true)
	face.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	v.add_child(face)
	for t in [["#%d" % (k + 1), 16, col], [str(e["name"]).replace(" [AI]", ""), 12, Color.WHITE], [value, 13, GOLD]]:
		var l := label(t[0], t[1], t[2], 2)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.clip_text = true
		l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		v.add_child(l)
	return p

# ----------------------------------------------------------------- tall content
static func _is_action_row(c: Node) -> bool:
	if c is Button:
		return true
	if c is HBoxContainer:
		for k in c.get_children():
			if k is Button:
				return true
	return false

## Gives a panel (PanelContainer > VBoxContainer) that is taller than its room a scroll area. The first
## `head` rows (a title) and up to two trailing button rows stay fixed, everything between scrolls.
## max_h > 0: the panel sizes itself (a popup) and must end up at most that tall.
## max_h <= 0: the panel is stretched by its anchors (a screen column) and the scroll area fills it.
static func fit_tall(p: PanelContainer, head: int, max_h: float) -> bool:
	if p.get_child_count() != 1 or not (p.get_child(0) is VBoxContainer):
		return false
	var v := p.get_child(0) as VBoxContainer
	for k0 in v.get_children():
		if k0.has_meta("autofit"):
			return true
		# A panel that already has a stretching scroll list looks after its own overflow. Wrapping it again
		# collapsed that list to nothing (Messenger's chat list vanished: a wrapping label reports a huge
		# height before its first layout, which looked like "too tall").
		if k0 is ScrollContainer and ((k0 as Control).size_flags_vertical & Control.SIZE_EXPAND) != 0:
			return false
	var kids: Array = v.get_children()
	var cut := kids.size()
	var pinned := 0
	while cut > head and pinned < 2:
		var k: Node = kids[cut - 1]
		if _is_action_row(k):
			pinned += 1
			cut -= 1
		elif k.get_class() == "Control" and pinned == 0 and k.get_child_count() == 0:
			cut -= 1   # a trailing spacer: the scroll area takes its job
			kids.remove_at(cut)
			v.remove_child(k)
			k.queue_free()
		else:
			break
	if cut <= head:
		return false
	var mid := vbox(v.get_theme_constant("separation"))
	for i in range(head, cut):
		var k2: Node = kids[i]
		v.remove_child(k2)
		if k2.get_class() == "Control" and k2.get_child_count() == 0 and ((k2 as Control).size_flags_vertical & Control.SIZE_EXPAND) != 0:
			k2.queue_free()   # spacers have nothing to push apart inside a scroll area
			continue
		mid.add_child(k2)
	var sc := scroll(mid)
	sc.set_meta("autofit", true)
	v.add_child(sc)
	v.move_child(sc, head)
	if max_h > 0.0:
		# everything except the scroll area keeps its height; the scroll area gets what is left
		var rest: float = p.get_combined_minimum_size().y
		sc.custom_minimum_size.y = maxf(120.0, max_h - rest - float(v.get_theme_constant("separation")))
	return true

# ----------------------------------------------------------------- scrim
## A soft dark fade for text that sits on artwork. `from_top`: dark at the top edge fading down, else dark
## at the bottom fading up. Anchored to that edge of its parent, `height` px tall; add it BEFORE the text.
static func scrim(from_top: bool, height: float, alpha: float = 0.8, tint: Color = Color(0.03, 0.01, 0.07)) -> TextureRect:
	var g := Gradient.new()
	g.set_color(0, Color(tint, alpha))
	g.set_color(1, Color(tint, 0.0))
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.width = 4
	gt.height = 64
	gt.fill_from = Vector2(0, 0) if from_top else Vector2(0, 1)
	gt.fill_to = Vector2(0, 1) if from_top else Vector2(0, 0)
	var t := TextureRect.new()
	t.texture = gt
	t.stretch_mode = TextureRect.STRETCH_SCALE
	t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	t.mouse_filter = Control.MOUSE_FILTER_IGNORE
	t.set_anchors_and_offsets_preset(Control.PRESET_TOP_WIDE if from_top else Control.PRESET_BOTTOM_WIDE)
	if from_top:
		t.offset_bottom = height
	else:
		t.offset_top = -height
	return t

# ----------------------------------------------------------------- avatar
## One avatar look for the whole game: the hero's full-body battle sprite on a soft backdrop in her colour,
## inside a rounded frame. (Avatars used to be face crops of the illustration, which came out differently
## for every hero: some a face, some a shoulder, some half a wing.) Heroes without a sprite fall back to the face.
## The player's own Commander avatar (their chosen hero and sprite form).
static func my_avatar(sz: float, ring: Color = GOLD, ring_w: int = 2) -> Control:
	return avatar(Game.avatar_id(), sz, ring, ring_w, Game.avatar_form())

## `form` >= 0 picks one of DB.sprite_forms(id) (0 = Lv1); -1 follows the hero's stars and outfit.
static func avatar(id: String, sz: float, ring: Color = GOLD, ring_w: int = 2, form: int = -1) -> Control:
	var c := Control.new()
	c.custom_minimum_size = Vector2(sz, sz)
	c.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	c.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var rad := int(sz * 0.22)
	var clip := Panel.new()
	clip.clip_children = CanvasItem.CLIP_CHILDREN_ONLY
	clip.add_theme_stylebox_override("panel", style(Color.WHITE, Color.TRANSPARENT, rad, 0, 0))
	clip.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	clip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.add_child(clip)
	var tc: Color = DB.theme_color(id)
	var g := Gradient.new()
	g.set_color(0, tc.lerp(Color(0.16, 0.1, 0.26), 0.45))
	g.set_color(1, Color(0.05, 0.03, 0.1))
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.fill = GradientTexture2D.FILL_RADIAL
	gt.fill_from = Vector2(0.5, 0.42)
	gt.fill_to = Vector2(1.0, 1.0)
	gt.width = 32
	gt.height = 32
	var bg := TextureRect.new()
	bg.texture = gt
	bg.stretch_mode = TextureRect.STRETCH_SCALE
	bg.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	clip.add_child(bg)
	var star := 1
	var skin := -1
	if Game.owns(id):
		star = int(Game.hero(id).get("star", 1))
		skin = int(Game.hero(id).get("skin", 0))
	var sp: Texture2D = DB.sprite(id, star, skin)
	if form >= 0:
		var fl := DB.sprite_forms(id)
		if not fl.is_empty():
			sp = DB.tex(str(fl[clampi(form, 0, fl.size() - 1)]))
	var pic: TextureRect
	if sp != null:
		pic = tex_rect(sp)          # whole body, aspect kept
		pic.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		var m := sz * 0.05
		pic.offset_left = m
		pic.offset_top = m
		pic.offset_right = -m
		pic.offset_bottom = -m
	else:
		pic = tex_rect(DB.face(id), Vector2.ZERO, true)
		pic.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	clip.add_child(pic)
	var ring_p := Panel.new()
	ring_p.add_theme_stylebox_override("panel", style(Color.TRANSPARENT, ring, rad, ring_w, 0))
	ring_p.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	ring_p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.add_child(ring_p)
	return c

# ----------------------------------------------------------------- light shafts
## Full-screen volumetric light (game/ui/light_shafts.gdshader). Add it right above a backdrop.
static func light_shafts(tint: Color = Color(1.0, 0.9, 0.72), strength: float = 0.7, origin: Vector2 = Vector2(0.08, -0.35)) -> ColorRect:
	var r := ColorRect.new()
	r.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sm := ShaderMaterial.new()
	sm.shader = load("res://game/ui/light_shafts.gdshader")
	sm.set_shader_parameter("tint", tint)
	sm.set_shader_parameter("strength", strength)
	sm.set_shader_parameter("origin", origin)
	sm.set_shader_parameter("dust", 0.0 if Game.reduce_fx() else 1.0)
	r.material = sm
	var fit := func():
		if r.size.y > 1.0:
			sm.set_shader_parameter("aspect", r.size.x / r.size.y)
	r.resized.connect(fit)
	return r

# ----------------------------------------------------------------- hero aura
## A soft glow in the hero's colour behind her art that slowly breathes (brightness only: nothing moves,
## so it can never look like stutter). Add it to the art's parent right BEFORE the art. `art` is the
## TextureRect it should sit behind; the glow follows its rect.
static func hero_aura(art: Control, col: Color, strength: float = 0.55) -> TextureRect:
	var g := Gradient.new()
	g.set_color(0, Color(col, 1.0))
	g.set_color(1, Color(col, 0.0))
	g.add_point(0.45, Color(col, 0.35))
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.fill = GradientTexture2D.FILL_RADIAL
	gt.fill_from = Vector2(0.5, 0.5)
	gt.fill_to = Vector2(1.0, 0.5)
	gt.width = 128
	gt.height = 128
	var a := TextureRect.new()
	a.texture = gt
	a.stretch_mode = TextureRect.STRETCH_SCALE
	a.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	a.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var add := CanvasItemMaterial.new()
	add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	a.material = add
	var place := func():
		if is_instance_valid(art) and is_instance_valid(a):
			# an oval around the upper body (where the eye goes), a bit wider than the art
			var r := art.get_rect()
			a.position = r.position + Vector2(-r.size.x * 0.1, r.size.y * 0.02)
			a.size = Vector2(r.size.x * 1.2, r.size.y * 0.85)
	art.item_rect_changed.connect(place)
	place.call_deferred()
	a.modulate.a = strength * 0.6
	if not Game.reduce_fx():
		var tw := a.create_tween().set_loops()
		tw.tween_property(a, "modulate:a", strength, 2.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(a, "modulate:a", strength * 0.55, 2.6).set_trans(Tween.TRANS_SINE)
	return a
