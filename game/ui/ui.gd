class_name UI
extends RefCounted
## Shared UI factory: one visual language for every screen.

const GOLD := Color("#ffd479")
const GOLD_DARK := Color("#b8862f")
const TEXT := Color("#f2ecff")
const MUTED := Color("#a79cc0")
const PANEL := Color(0.07, 0.05, 0.12, 0.88)
const PANEL_LIGHT := Color(0.13, 0.10, 0.21, 0.92)
const BORDER := Color("#4a3a6e")
const ACCENT := Color("#b48cff")
const GREEN := Color("#7dffb0")
const SUB_STAT := Color("#9fd8ff")
const RED := Color("#ff6b7d")

static var _theme: Theme

static func style(bg: Color, border: Color = Color.TRANSPARENT, radius: int = 10, bw: int = 0, pad: float = 10.0, shadow: int = 0) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = bg
	s.border_color = border
	s.set_border_width_all(bw)
	s.set_corner_radius_all(radius)
	s.content_margin_left = pad
	s.content_margin_right = pad
	s.content_margin_top = pad * 0.6
	s.content_margin_bottom = pad * 0.6
	s.anti_aliasing = true
	if shadow > 0:
		s.shadow_color = Color(0, 0, 0, 0.45)
		s.shadow_size = shadow
		s.shadow_offset = Vector2(0, 3)
	return s

## 9-slice textured style from art/ui (falls back to a flat style if the PNG is missing).
static func tex_box(file: String, margin: float, pad_x: float, pad_y: float, fallback: StyleBox) -> StyleBox:
	var p := "res://art/ui/%s" % file
	if not ResourceLoader.exists(p):
		return fallback
	var s := StyleBoxTexture.new()
	s.texture = load(p)
	s.texture_margin_left = margin
	s.texture_margin_right = margin
	s.texture_margin_top = margin
	s.texture_margin_bottom = margin
	s.content_margin_left = pad_x
	s.content_margin_right = pad_x
	s.content_margin_top = pad_y
	s.content_margin_bottom = pad_y
	return s

static func theme() -> Theme:
	if _theme:
		return _theme
	var t := Theme.new()
	t.default_font_size = 16
	# Buttons
	t.set_stylebox("normal", "Button", style(Color("#1d1530"), Color("#5b4790"), 10, 2, 14))
	t.set_stylebox("hover", "Button", style(Color("#2a1f47"), Color("#9d7cff"), 10, 2, 14))
	t.set_stylebox("pressed", "Button", style(Color("#3a2a63"), Color("#d6c2ff"), 10, 2, 14))
	t.set_stylebox("disabled", "Button", style(Color("#151020"), Color("#2d2540"), 10, 2, 14))
	t.set_stylebox("focus", "Button", StyleBoxEmpty.new())
	t.set_color("font_color", "Button", TEXT)
	t.set_color("font_hover_color", "Button", Color.WHITE)
	t.set_color("font_pressed_color", "Button", Color.WHITE)
	t.set_color("font_disabled_color", "Button", Color("#6b6280"))
	t.set_font_size("font_size", "Button", 16)
	# Gold primary button
	t.set_type_variation("GoldButton", "Button")
	t.set_stylebox("normal", "GoldButton", style(Color("#c8902c"), Color("#ffe6a3"), 12, 2, 16, 4))
	t.set_stylebox("hover", "GoldButton", style(Color("#e0a73a"), Color("#fff3cf"), 12, 2, 16, 4))
	t.set_stylebox("pressed", "GoldButton", style(Color("#a8741c"), Color("#ffe6a3"), 12, 2, 16, 2))
	t.set_stylebox("disabled", "GoldButton", style(Color("#4a3c25"), Color("#6e5b3a"), 12, 2, 16))
	t.set_color("font_color", "GoldButton", Color("#2a1600"))
	t.set_color("font_hover_color", "GoldButton", Color("#1a0d00"))
	t.set_color("font_pressed_color", "GoldButton", Color("#1a0d00"))
	t.set_color("font_disabled_color", "GoldButton", Color("#8d7a5b"))
	t.set_font_size("font_size", "GoldButton", 18)
	# Tab-like toggle
	t.set_type_variation("TabButton", "Button")
	t.set_stylebox("normal", "TabButton", style(Color(0.1, 0.08, 0.17, 0.85), Color("#3e3160"), 8, 1, 12))
	t.set_stylebox("hover", "TabButton", style(Color(0.16, 0.12, 0.26, 0.9), Color("#7d64c9"), 8, 1, 12))
	t.set_stylebox("pressed", "TabButton", style(Color("#4b347e"), GOLD, 8, 2, 12))
	t.set_stylebox("focus", "TabButton", StyleBoxEmpty.new())
	t.set_color("font_pressed_color", "TabButton", GOLD)
	# Flat icon button
	t.set_type_variation("FlatButton", "Button")
	for st in ["normal", "hover", "pressed", "disabled"]:
		t.set_stylebox(st, "FlatButton", style(Color(0, 0, 0, 0.0 if st == "normal" else 0.18), Color.TRANSPARENT, 10, 0, 4))
	t.set_stylebox("focus", "FlatButton", StyleBoxEmpty.new())
	# Panels
	t.set_stylebox("panel", "PanelContainer", style(PANEL, BORDER, 14, 1, 14, 6))
	t.set_type_variation("CardPanel", "PanelContainer")
	t.set_stylebox("panel", "CardPanel", style(PANEL_LIGHT, Color("#5a4888"), 12, 1, 10))
	t.set_type_variation("ClearPanel", "PanelContainer")
	t.set_stylebox("panel", "ClearPanel", StyleBoxEmpty.new())
	# ---- textured UI kit (art/ui, generated by tools/gen_ui_kit.py — swap PNGs for artist art)
	for st in [["normal", "btn.png"], ["hover", "btn_hover.png"], ["pressed", "btn_pressed.png"], ["disabled", "btn_disabled.png"]]:
		t.set_stylebox(st[0], "Button", tex_box(st[1], 12, 14, 8, t.get_stylebox(st[0], "Button")))
	for st in [["normal", "btn_gold.png"], ["hover", "btn_gold_hover.png"], ["pressed", "btn_gold_pressed.png"], ["disabled", "btn_gold_disabled.png"]]:
		t.set_stylebox(st[0], "GoldButton", tex_box(st[1], 12, 16, 9, t.get_stylebox(st[0], "GoldButton")))
	t.set_stylebox("normal", "TabButton", tex_box("tab.png", 10, 12, 7, t.get_stylebox("normal", "TabButton")))
	t.set_stylebox("hover", "TabButton", tex_box("btn_hover.png", 12, 12, 7, t.get_stylebox("hover", "TabButton")))
	t.set_stylebox("pressed", "TabButton", tex_box("tab_on.png", 10, 12, 7, t.get_stylebox("pressed", "TabButton")))
	t.set_stylebox("panel", "PanelContainer", tex_box("panel.png", 24, 16, 14, t.get_stylebox("panel", "PanelContainer")))
	t.set_stylebox("panel", "CardPanel", tex_box("card.png", 18, 12, 9, t.get_stylebox("panel", "CardPanel")))
	t.set_type_variation("OrnatePanel", "PanelContainer")
	t.set_stylebox("panel", "OrnatePanel", tex_box("popup.png", 30, 26, 22, style(Color(0.08, 0.05, 0.14, 0.98), GOLD_DARK, 16, 2, 22)))
	t.set_type_variation("RibbonPanel", "PanelContainer")
	var rib := tex_box("ribbon.png", 20, 40, 6, style(Color("#4b347e"), GOLD, 8, 2, 12))
	if rib is StyleBoxTexture:
		(rib as StyleBoxTexture).texture_margin_top = 10
		(rib as StyleBoxTexture).texture_margin_bottom = 10
	t.set_stylebox("panel", "RibbonPanel", rib)
	# Labels
	t.set_color("font_color", "Label", TEXT)
	t.set_color("font_outline_color", "Label", Color(0, 0, 0, 0.85))
	t.set_constant("outline_size", "Label", 0)
	t.set_font_size("font_size", "Label", 16)
	# Progress bars
	t.set_stylebox("background", "ProgressBar", style(Color(0, 0, 0, 0.55), Color("#3a2f55"), 6, 1, 0))
	t.set_stylebox("fill", "ProgressBar", style(Color("#9b6bff"), Color.TRANSPARENT, 6, 0, 0))
	t.set_font_size("font_size", "ProgressBar", 11)
	t.set_type_variation("GoldBar", "ProgressBar")
	t.set_stylebox("fill", "GoldBar", style(GOLD, Color.TRANSPARENT, 6, 0, 0))
	t.set_type_variation("HpBar", "ProgressBar")
	t.set_stylebox("fill", "HpBar", style(Color("#5ce07a"), Color.TRANSPARENT, 3, 0, 0))
	t.set_stylebox("background", "HpBar", style(Color(0, 0, 0, 0.7), Color(0, 0, 0, 0.9), 3, 1, 0))
	t.set_type_variation("EnemyHpBar", "ProgressBar")
	t.set_stylebox("fill", "EnemyHpBar", style(Color("#ff5c6c"), Color.TRANSPARENT, 3, 0, 0))
	t.set_stylebox("background", "EnemyHpBar", style(Color(0, 0, 0, 0.7), Color(0, 0, 0, 0.9), 3, 1, 0))
	# Scroll
	var grab := style(Color("#6c55a8"), Color.TRANSPARENT, 4, 0, 0)
	t.set_stylebox("grabber", "VScrollBar", grab)
	t.set_stylebox("grabber_highlight", "VScrollBar", grab)
	t.set_stylebox("grabber_pressed", "VScrollBar", grab)
	t.set_stylebox("scroll", "VScrollBar", style(Color(0, 0, 0, 0.25), Color.TRANSPARENT, 4, 0, 0))
	t.set_stylebox("grabber", "HScrollBar", grab)
	t.set_stylebox("grabber_highlight", "HScrollBar", grab)
	t.set_stylebox("grabber_pressed", "HScrollBar", grab)
	t.set_stylebox("scroll", "HScrollBar", style(Color(0, 0, 0, 0.25), Color.TRANSPARENT, 4, 0, 0))
	# Sliders
	t.set_stylebox("slider", "HSlider", style(Color(0, 0, 0, 0.5), Color("#3a2f55"), 4, 1, 3))
	t.set_stylebox("grabber_area", "HSlider", style(Color("#9b6bff"), Color.TRANSPARENT, 4, 0, 3))
	t.set_stylebox("grabber_area_highlight", "HSlider", style(Color("#b48cff"), Color.TRANSPARENT, 4, 0, 3))
	_theme = t
	return t

# ------------------------------------------------------------------ builders

const MIN_FONT := 12

static func label(text: String, size: int = 16, color: Color = TEXT, outline: int = 0) -> Label:
	var l := Label.new()
	l.text = text
	size = maxi(size, MIN_FONT)
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	if outline > 0:
		l.add_theme_constant_override("outline_size", outline)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l

static func wrap_label(text: String, size: int = 14, color: Color = MUTED) -> Label:
	var l := label(text, size, color)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	return l

static func button(text: String, cb: Callable = Callable(), variant: String = "", min_size: Vector2 = Vector2(0, 44)) -> Button:
	var b := Button.new()
	b.text = text
	b.custom_minimum_size = min_size
	b.focus_mode = Control.FOCUS_NONE
	b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	if variant != "":
		b.theme_type_variation = variant
	if cb.is_valid():
		b.pressed.connect(func():
			Game.sfx("ui_click")
			cb.call())
	hover_fx(b)
	return b

## Hover grow + press squash for any Control button.
static func hover_fx(b: BaseButton, grow: float = 1.04) -> void:
	b.mouse_entered.connect(func():
		if b.disabled:
			return
		b.pivot_offset = b.size * 0.5
		b.create_tween().tween_property(b, "scale", Vector2(grow, grow), 0.1).set_trans(Tween.TRANS_QUAD))
	b.mouse_exited.connect(func():
		b.create_tween().tween_property(b, "scale", Vector2.ONE, 0.12).set_trans(Tween.TRANS_QUAD))
	b.button_down.connect(func():
		b.pivot_offset = b.size * 0.5
		b.create_tween().tween_property(b, "scale", Vector2(0.94, 0.94), 0.05))
	b.button_up.connect(func():
		var tw := b.create_tween()
		tw.tween_property(b, "scale", Vector2(1.06, 1.06), 0.07).set_trans(Tween.TRANS_BACK)
		tw.tween_property(b, "scale", Vector2.ONE, 0.08))

## Staggered entrance for all children of a container (fade + scale pop).
static func stagger(container: Node, step: float = 0.035, max_items: int = 30) -> void:
	var i := 0
	for c in container.get_children():
		if not (c is CanvasItem) or c.is_queued_for_deletion():
			continue
		var ci := c as CanvasItem
		ci.modulate.a = 0.0
		var d := minf(i, max_items) * step
		var tw := ci.create_tween()
		tw.tween_interval(d)
		tw.tween_property(ci, "modulate:a", 1.0, 0.22)
		if c is Control:
			var cc := c as Control
			cc.scale = Vector2(0.92, 0.92)
			tw.parallel().tween_callback(func(): cc.pivot_offset = cc.size * 0.5)
			tw.parallel().tween_property(cc, "scale", Vector2.ONE, 0.28).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		i += 1

## Counts a label's number up/down from `from` to `to`.
static func count_to(l: Label, from: int, to: int, fmt_fn: Callable, dur: float = 0.5) -> void:
	if from == to:
		l.text = fmt_fn.call(to)
		return
	var tw := l.create_tween()
	tw.tween_method(func(v: float): l.text = fmt_fn.call(int(v)), float(from), float(to), dur).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	l.pivot_offset = l.size * 0.5
	var p := l.create_tween()
	p.tween_property(l, "scale", Vector2(1.15, 1.15), 0.1)
	p.tween_property(l, "scale", Vector2.ONE, 0.2)

static func icon_button(tex: Texture2D, text: String, cb: Callable, size: float = 64.0, badge: int = 0) -> Control:
	var b := Button.new()
	b.theme_type_variation = "FlatButton"
	b.custom_minimum_size = Vector2(size + 16, size + 22)
	b.focus_mode = Control.FOCUS_NONE
	b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	b.pressed.connect(func():
		Game.sfx("ui_click")
		cb.call())
	hover_fx(b, 1.08)
	var v := VBoxContainer.new()
	v.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.add_theme_constant_override("separation", 0)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	b.add_child(v)
	var ic := TextureRect.new()
	ic.texture = tex
	ic.custom_minimum_size = Vector2(size, size)
	ic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	ic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	v.add_child(ic)
	var l := label(text, 13, TEXT, 4)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(l)
	if badge > 0:
		add_badge(b, badge)
	return b

static func add_badge(parent: Control, n: int) -> void:
	var p := Panel.new()
	p.add_theme_stylebox_override("panel", style(Color("#ff3b5c"), Color.WHITE, 10, 2, 0))
	p.custom_minimum_size = Vector2(22, 22)
	p.size = Vector2(22, 22)
	p.position = Vector2(parent.custom_minimum_size.x - 26, 2)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var l := label(str(n) if n < 10 else "!", 12, Color.WHITE)
	l.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	p.add_child(l)
	parent.add_child(p)
	p.pivot_offset = Vector2(11, 11)
	var tw := p.create_tween().set_loops()
	tw.tween_property(p, "scale", Vector2(1.18, 1.18), 0.45).set_trans(Tween.TRANS_SINE)
	tw.tween_property(p, "scale", Vector2.ONE, 0.45).set_trans(Tween.TRANS_SINE)

static func tex_rect(tex: Texture2D, size: Vector2 = Vector2.ZERO, cover: bool = false) -> TextureRect:
	var t := TextureRect.new()
	t.texture = tex
	t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	t.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED if cover else TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	t.custom_minimum_size = size
	t.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if cover:
		t.clip_contents = true
	return t

static func panel(variant: String = "", pad: int = -1) -> PanelContainer:
	var p := PanelContainer.new()
	if variant != "":
		p.theme_type_variation = variant
	if pad >= 0:
		var sb: StyleBoxFlat = (p.get_theme_stylebox("panel") as StyleBoxFlat)
		if sb:
			sb = sb.duplicate()
			sb.content_margin_left = pad
			sb.content_margin_right = pad
			sb.content_margin_top = pad
			sb.content_margin_bottom = pad
			p.add_theme_stylebox_override("panel", sb)
	return p

static func styled_panel(bg: Color, border: Color, radius: int = 12, bw: int = 1, pad: float = 10.0) -> PanelContainer:
	var p := PanelContainer.new()
	# major gold-framed panels get the ornate textured frame (keeps the requested padding)
	# (light backgrounds such as speech bubbles keep their flat style so dark text stays readable)
	if bw >= 2 and radius >= 12 and _is_gold(border) and bg.a >= 0.7 and bg.get_luminance() < 0.35:
		var tb := tex_box("panel.png", 24, maxf(pad, 14.0), maxf(pad * 0.75, 12.0), null)
		if tb != null:
			p.add_theme_stylebox_override("panel", tb)
			return p
	p.add_theme_stylebox_override("panel", style(bg, border, radius, bw, pad))
	return p

static func _is_gold(c: Color) -> bool:
	return c.is_equal_approx(GOLD) or c.is_equal_approx(GOLD_DARK) or (c.r > 0.65 and c.g > 0.45 and c.b < 0.5 and c.r > c.b + 0.3)

static func vbox(sep: int = 8) -> VBoxContainer:
	var v := VBoxContainer.new()
	v.add_theme_constant_override("separation", sep)
	return v

static func hbox(sep: int = 8) -> HBoxContainer:
	var h := HBoxContainer.new()
	h.add_theme_constant_override("separation", sep)
	return h

static func spacer(h: bool = true) -> Control:
	var c := Control.new()
	if h:
		c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	else:
		c.size_flags_vertical = Control.SIZE_EXPAND_FILL
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c

static func margin(child: Control, l: int, t: int, r: int, b: int) -> MarginContainer:
	var m := MarginContainer.new()
	m.add_theme_constant_override("margin_left", l)
	m.add_theme_constant_override("margin_top", t)
	m.add_theme_constant_override("margin_right", r)
	m.add_theme_constant_override("margin_bottom", b)
	m.add_child(child)
	return m

static func scroll(child: Control, horizontal: bool = false) -> ScrollContainer:
	var sc := DragScroll.new()
	sc.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO if horizontal else ScrollContainer.SCROLL_MODE_DISABLED
	sc.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED if horizontal else ScrollContainer.SCROLL_MODE_AUTO
	sc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.size_flags_vertical = Control.SIZE_EXPAND_FILL
	child.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sc.add_child(child)
	return sc

static func bar(value: float, max_value: float, variant: String = "", h: float = 12.0, show_pct: bool = false) -> ProgressBar:
	var p := ProgressBar.new()
	p.max_value = maxf(1.0, max_value)
	p.value = value
	p.show_percentage = show_pct
	p.custom_minimum_size = Vector2(0, h)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if variant != "":
		p.theme_type_variation = variant
	return p

static func stars(n: int, size: int = 16, max_n: int = 0) -> Label:
	var t := "★".repeat(n)
	if max_n > n:
		t += "☆".repeat(max_n - n)
	var l := label(t, size, GOLD, 3)
	return l

static func rarity_tag(rarity: String, size: int = 14) -> PanelContainer:
	var c: Color = DB.RARITY_COLOR.get(rarity, ACCENT)
	var p := styled_panel(c.darkened(0.55), c, 6, 2, 6)
	var l := label(rarity, size, c.lightened(0.2), 2)
	p.add_child(l)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return p

static func element_tag(elem: String, size: int = 13) -> HBoxContainer:
	var h := hbox(4)
	h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	h.add_child(tex_rect(DB.icon(DB.ELEMENT_ICON.get(elem, "elem_light")), Vector2(size + 8, size + 8)))
	h.add_child(label(elem, size, DB.ELEMENT_COLOR.get(elem, TEXT), 2))
	return h

static func reward_row(rewards: Dictionary, icon_size: float = 34.0, font: int = 14) -> HFlowContainer:
	var f := HFlowContainer.new()
	f.add_theme_constant_override("h_separation", 10)
	f.add_theme_constant_override("v_separation", 6)
	f.mouse_filter = Control.MOUSE_FILTER_IGNORE
	for k in rewards.keys():
		var h := hbox(4)
		h.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.add_child(tex_rect(Game.reward_icon(k), Vector2(icon_size, icon_size)))
		h.add_child(label("x" + Game.fmt(int(rewards[k])), font, GOLD, 3))
		f.add_child(h)
	return f

static var _live_shader: Shader

## Attach the pseudo-Live2D motion shader to a hero art TextureRect.
static func live(t: TextureRect, rim_col: Color = Color(1, 0.85, 1), strength: float = 1.0) -> void:
	if _live_shader == null:
		_live_shader = load("res://game/ui/live_art.gdshader")
	var m := ShaderMaterial.new()
	m.shader = _live_shader
	m.set_shader_parameter("strength", strength * (0.35 if Game.reduce_fx() else 1.0))
	m.set_shader_parameter("seed", randf() * 10.0)
	m.set_shader_parameter("rim_color", rim_col)
	if t.has_meta("corrupt_params"):
		t.remove_meta("corrupt_params")
	t.material = m
	# 2.5D rigged arts (DB.LIVE_RIGS) take over automatically while they are shown
	if not t.has_node("LiveRig"):
		var rig := LiveRig.new()
		rig.name = "LiveRig"
		t.add_child(rig)
	else:
		(t.get_node("LiveRig") as LiveRig).set_live(m)
	# pivot-rigged arts (DB.HERO_RIGS / ENEMY_RIGS): breathing, blinking, hair & tail sway
	var cr := CharRig.attach(t)
	if cr.is_inside_tree():
		cr.refresh()

static var _corrupt_shader: Shader

## Elite / corrupted enemy look (placeholder for unique enemy art).
static func corrupt(t: CanvasItem, variant: String = "") -> void:
	if _corrupt_shader == null:
		_corrupt_shader = load("res://game/ui/corrupt.gdshader")
	var m := ShaderMaterial.new()
	m.shader = _corrupt_shader
	if variant == "ashen":
		# Ashen (Arc 7): grey cinders with a glowing ember outline
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.85)
		m.set_shader_parameter("glow", Color("#ff9a3d"))
	elif variant == "echo":
		# Echo (Arc 6): faded sepia memory with a pale gold outline
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.75)
		m.set_shader_parameter("glow", Color("#f0dca0"))
	elif variant == "astral":
		# Astral (Arc 5 / Boss Hunt): starlit gold halo, colours kept closer to the original
		m.set_shader_parameter("hue_shift", 0.06)
		m.set_shader_parameter("glow", Color("#ffe27a"))
	elif variant == "feral":
		# Feral (Arc 9): drained, wild look with a blood-red hunting halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.5)
		m.set_shader_parameter("glow", Color("#ff3b2e"))
	elif variant == "frost":
		# Frostbound (Arc 11): pale glacier-blue skin of ice with a white-blue rime halo
		m.set_shader_parameter("hue_shift", 0.0)
		m.set_shader_parameter("desat", 0.8)
		m.set_shader_parameter("tone", Vector3(0.74, 1.08, 1.62))
		m.set_shader_parameter("glow", Color("#bff0ff"))
	elif variant == "hollow":
		# Hollow (Arc 4): drained, icy-teal look with a cyan halo
		m.set_shader_parameter("hue_shift", 0.45)
		m.set_shader_parameter("glow", Color("#4ff0ff"))
	t.material = m
	# 2.5D: a rigged / depth-mapped art keeps its depth and gets the variant look on top
	if t is TextureRect:
		t.set_meta("corrupt_params", {"hue_shift": m.get_shader_parameter("hue_shift"), "desat": m.get_shader_parameter("desat"), "variant_glow": m.get_shader_parameter("glow"), "tone": m.get_shader_parameter("tone")})
		if not t.has_node("LiveRig"):
			var rig := LiveRig.new()
			rig.name = "LiveRig"
			t.add_child(rig)
		else:
			(t.get_node("LiveRig") as LiveRig).set_live(m)

## Tap-to-animate banner: plays frames 1→2→3… once like a GIF and holds on the last one.
static func play_frames(t: TextureRect, frames: Array, step: float = 0.32) -> void:
	if t.has_meta("frames_tw"):
		var old: Tween = t.get_meta("frames_tw")
		if old and old.is_valid():
			old.kill()
	var tw := t.create_tween()
	for i in frames.size():
		var p: String = frames[i]
		tw.tween_callback(func():
			t.texture = DB.tex(p)
			t.pivot_offset = t.size * 0.5
			t.scale = Vector2(1.04, 1.04))
		tw.tween_property(t, "scale", Vector2.ONE, step * 0.6).set_trans(Tween.TRANS_BACK)
		tw.tween_interval(step * 0.4)
	t.set_meta("frames_tw", tw)

## Show an alternate expression for a moment, then restore (used on touch).
static func flash_expression(t: TextureRect, alt: Texture2D, hold: float = 1.6) -> void:
	if alt == null or t.has_meta("expr_busy"):
		return
	var orig := t.texture
	t.set_meta("expr_busy", true)
	t.texture = alt
	var tw := t.create_tween()
	tw.tween_interval(hold)
	tw.tween_callback(func():
		if is_instance_valid(t):
			t.texture = orig
			t.remove_meta("expr_busy"))

static func fade_in(node: CanvasItem, dur: float = 0.25, from_offset: Vector2 = Vector2(0, 16)) -> void:
	node.modulate.a = 0.0
	var tw := node.create_tween().set_parallel(true).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_property(node, "modulate:a", 1.0, dur)
	if node is Control and from_offset != Vector2.ZERO:
		var c := node as Control
		var target := c.position
		c.position = target + from_offset
		tw.tween_property(c, "position", target, dur)

static func pop(node: Control, dur: float = 0.3) -> void:
	node.pivot_offset = node.size * 0.5
	node.scale = Vector2(0.6, 0.6)
	node.modulate.a = 0.0
	var tw := node.create_tween().set_parallel(true).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(node, "scale", Vector2.ONE, dur)
	tw.tween_property(node, "modulate:a", 1.0, dur * 0.6)

static func breathe(node: Control, amount: float = 0.012, period: float = 3.2) -> void:
	node.pivot_offset = Vector2(node.size.x * 0.5, node.size.y)
	var tw := node.create_tween().set_loops()
	tw.tween_property(node, "scale", Vector2(1.0 + amount * 0.4, 1.0 + amount), period * 0.5).set_trans(Tween.TRANS_SINE)
	tw.tween_property(node, "scale", Vector2.ONE, period * 0.5).set_trans(Tween.TRANS_SINE)

## Top-3 podium card for leaderboards (k = 0 gold, 1 silver, 2 bronze). e: {name, hero, me}.
## Round "view full screen" button (magnifier icon) that opens ArtViewer.
static func zoom_button(on_press: Callable) -> Button:
	var b := Button.new()
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(58, 58)
	b.icon = DB.icon("icon_zoom")
	b.expand_icon = true
	b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	b.tooltip_text = "View full screen (pinch to zoom, tap to interact)"
	b.add_theme_constant_override("icon_max_width", 34)
	b.add_theme_stylebox_override("normal", style(Color(0.08, 0.04, 0.16, 0.86), Color(GOLD, 0.8), 29, 2, 10))
	b.add_theme_stylebox_override("hover", style(Color(0.2, 0.1, 0.32, 0.95), GOLD, 29, 3, 10))
	b.add_theme_stylebox_override("pressed", style(Color(0.3, 0.16, 0.42, 0.95), GOLD, 29, 3, 10))
	b.pressed.connect(func():
		Game.sfx("ui_click")
		on_press.call())
	var tw := b.create_tween().set_loops()
	tw.tween_property(b, "self_modulate", Color(1.25, 1.15, 0.9), 1.1).set_trans(Tween.TRANS_SINE)
	tw.tween_property(b, "self_modulate", Color.WHITE, 1.1).set_trans(Tween.TRANS_SINE)
	return b

static func podium(e: Dictionary, k: int, value: String) -> Control:
	var cols := [GOLD, Color("#d8d8e8"), Color("#e0a070")]
	var col: Color = cols[k]
	var me: bool = e.get("me", false)
	var p := styled_panel(Color(col, 0.12) if not me else Color(0.25, 0.18, 0.05, 0.95), col, 12, 2 if (k == 0 or me) else 1, 6.0)
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	p.size_flags_vertical = Control.SIZE_SHRINK_END
	var v := vbox(3)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	p.add_child(v)
	if k == 0:
		var cr := label("♛", 20, col, 3)
		cr.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		v.add_child(cr)
	var face := tex_rect(DB.face(e["hero"]), Vector2(56, 56) if k == 0 else Vector2(46, 46), true)
	face.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	v.add_child(face)
	for t in [["#%d" % (k + 1), 16, col], [str(e["name"]).replace(" [AI]", ""), 12, Color.WHITE], [value, 13, GOLD]]:
		var l := label(t[0], t[1], t[2], 2)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.clip_text = true
		v.add_child(l)
	return p
